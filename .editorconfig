# oxfmt owns js, ts, css, json and markdown. This is for the files it does not read,
# and for editors that open one before any tooling runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
