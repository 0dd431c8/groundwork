{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import",
    "unicorn",
    "oxc",
    "promise",
    "jsx-a11y",
    "vitest",
    "node",
  ],
  "options": {
    // Runs the type-aware rules below against the real TypeScript program, which is the
    // only tier that sees across a call boundary. Requires TypeScript 7. Costs ~0.1s.
    "typeAware": true,
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    // `style` is off: oxfmt already owns nearly all of it. `restriction` is off as a
    // category because it bans `async`/`await`; its two useful rules are listed below.
    // `react-perf` is off: its remedy is useCallback around children that are not memoised.
  },
  "env": {
    "browser": true,
    "es2024": true,
  },
  "ignorePatterns": ["dist", "src/routeTree.gen.ts"],
  "rules": {
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": [
      "error",
      { "max": 40, "skipBlankLines": true, "skipComments": true, "IIFEs": true },
    ],
    "complexity": ["error", 15],

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    // `@ts-ignore` silences an error and forgets it; `@ts-expect-error` fails once the
    // underlying problem is fixed, and the description says what it was.
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": "allow-with-description", "ts-ignore": true, "ts-nocheck": true },
    ],
    // An inferred return type that is subtly wrong fails at the boundary, not downstream.
    "typescript/explicit-module-boundary-types": "error",
    "no-console": "error",

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-array-delete": "error",
    "typescript/prefer-promise-reject-errors": "error",

    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/prefer-nullish-coalescing": "error",

    "import/no-cycle": "error",
    // Keep in sync with the src/features/*/*.state.ts override below: an override that
    // redeclares this rule replaces it wholesale rather than merging.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect"],
            "message": "useEffect is banned. Derive state, use event handlers, or - if truly unavoidable - add `// oxlint-disable-next-line no-restricted-imports` on the import with a justification comment.",
          },
        ],
        "patterns": [
          {
            "group": ["@/features/*/*"],
            "message": "Import a feature through its index (`@/features/counter`), not its internals. Inside a feature, import relatively (`./counter.state`).",
          },
        ],
      },
    ],

    // Wrong under the automatic JSX runtime, and 44 of the 47 findings in `suspicious`.
    "react/react-in-jsx-scope": "off",
    // The CSS and jest-dom side-effect imports are correct code.
    "import/no-unassigned-import": "off",
    // Wants `readonly` on every object parameter, React props included. 13 findings, no bugs.
    "typescript/prefer-readonly-parameter-types": "off",
    // Without the option, `onClick={() => step(-1)}` needs a braced body just because
    // `step` returns void. The rest of the rule stays on.
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],

    "typescript/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "ignoreRestSiblings": true },
    ],
  },
  "overrides": [
    {
      // The git hook is a CLI: printing is how it reports, and it exits on the awaited
      // result, so `return await` is the correct form.
      "files": [".githooks/**/*.ts"],
      "rules": {
        "no-console": "off",
        "typescript/return-await": "off",
      },
    },
    {
      "files": ["src/**/*.test.{ts,tsx}", "src/test/**/*", "build/**/*.test.ts"],
      "rules": {
        "max-lines-per-function": "off",
        "max-lines": "off",
        // Test helpers stay next to the cases that use them.
        "unicorn/consistent-function-scoping": "off",
      },
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "no-restricted-imports": "off",
        "typescript/explicit-module-boundary-types": "off",
      },
    },
    {
      // Client state must not reach up into the server-state layer or the transport. The
      // base entries are repeated because oxlint replaces the rule rather than merging it.
      "files": ["src/features/*/*.state.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect"],
                "message": "useEffect is banned. Derive state, use event handlers, or - if truly unavoidable - add `// oxlint-disable-next-line no-restricted-imports` on the import with a justification comment.",
              },
            ],
            "patterns": [
              {
                "group": ["@/features/*/*"],
                "message": "Import a feature through its index (`@/features/counter`), not its internals. Inside a feature, import relatively (`./counter.state`).",
              },
              {
                "group": ["./*.queries", "./*.api"],
                "message": "Dependencies point one way: .state.ts <- .queries.ts <- components. Client state must not import the server-state layer or the transport. Derive the other direction instead.",
              },
            ],
          },
        ],
      },
    },
  ],
}
