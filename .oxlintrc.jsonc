{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import",
    "unicorn",
    "oxc",
    "promise",
    "jsx-a11y",
    "vitest",
    "node",
  ],
  "options": {
    // Type-aware rules, run through `oxlint-tsgolint` against the real TypeScript
    // program. This is the only tier that sees across a call boundary, so it is what
    // catches an unawaited promise or an `any` spreading out of an untyped edge.
    // Requires TypeScript 7; do not downgrade TypeScript without removing this first.
    // Measured at ~0.1s extra on this codebase, so it is on for every run.
    "typeAware": true,
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    // `style` is off: 253 findings, nearly all of it formatting that oxfmt already owns.
    // `restriction` is off as a category, because it bans `async`/`await` and enforces a
    // .jsx extension. The two rules from it worth having are listed individually below.
    // The `react-perf` plugin is not enabled either: everything it reports here is an
    // inline arrow in a JSX prop, and its remedy is useCallback around children that are
    // not memoised, which costs more than it saves.
  },
  "env": {
    "browser": true,
    "es2024": true,
  },
  "ignorePatterns": ["dist", "src/routeTree.gen.ts"],
  "rules": {
    // --- Size and shape ---
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": [
      "error",
      { "max": 40, "skipBlankLines": true, "skipComments": true, "IIFEs": true },
    ],
    "complexity": ["error", 15],

    // --- Escape hatches an agent reaches for when the types get inconvenient ---
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    // `@ts-ignore` silences an error and forgets it; `@ts-expect-error` fails once the
    // underlying problem is fixed, and the description says what it was.
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": "allow-with-description", "ts-ignore": true, "ts-nocheck": true },
    ],
    // Exported functions state their return type. An inferred one that is subtly wrong
    // becomes an error here, at the boundary, instead of somewhere downstream.
    "typescript/explicit-module-boundary-types": "error",
    "no-console": "error",

    // --- Type-aware: defects ---
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-array-delete": "error",
    "typescript/prefer-promise-reject-errors": "error",

    // --- Type-aware: keeping `any` from spreading ---
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/prefer-nullish-coalescing": "error",

    // --- Architecture ---
    "import/no-cycle": "error",
    // Keep in sync with the src/features/*/*.state.ts override below. oxlint replaces
    // this rule wholesale rather than merging when an override redeclares it, so the
    // override has to repeat every entry it still wants.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect"],
            "message": "useEffect is banned. Derive state, use event handlers, or - if truly unavoidable - add `// oxlint-disable-next-line no-restricted-imports` on the import with a justification comment.",
          },
        ],
        "patterns": [
          {
            "group": ["@/features/*/*"],
            "message": "Import a feature through its index (`@/features/counter`), not its internals. Inside a feature, import relatively (`./counter.state`).",
          },
        ],
      },
    ],

    // --- Relaxed from the categories above, each for a stated reason ---
    // The automatic JSX runtime (`jsx: "react-jsx"`) means React is never in scope, so
    // this rule is wrong here. It is 44 of the 47 findings the suspicious category
    // reports; without this line that category is unusable.
    "react/react-in-jsx-scope": "off",
    // Side-effect imports are the point at `import './styles/index.css'` and
    // `import '@testing-library/jest-dom/vitest'`. Both are correct code.
    "import/no-unassigned-import": "off",
    // Would require `readonly` on every object and array parameter, React props
    // included. 13 findings here, none of them a bug. typescript-eslint documents it as
    // very strict; it buys ceremony rather than safety in an app this shape.
    "typescript/prefer-readonly-parameter-types": "off",
    // `onClick={() => step(-1)}` is the normal way to write a handler. Without this
    // option the rule demands a braced body purely because `step` returns void. The
    // rest of the rule, which catches a void expression used as a value, stays on.
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],

    "typescript/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "ignoreRestSiblings": true },
    ],
  },
  "overrides": [
    {
      // The git hook is a CLI: printing is how it reports, and it runs in Bun where the
      // process exits on the awaited result, so `return await` is the correct form.
      "files": [".githooks/**/*.ts"],
      "rules": {
        "no-console": "off",
        "typescript/return-await": "off",
      },
    },
    {
      "files": ["src/**/*.test.{ts,tsx}", "src/test/**/*"],
      "rules": {
        "max-lines-per-function": "off",
        "max-lines": "off",
        // Test helpers are defined next to the cases that use them, which is clearer
        // than hoisting them away from their context to satisfy the rule.
        "unicorn/consistent-function-scoping": "off",
      },
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "no-restricted-imports": "off",
        "typescript/explicit-module-boundary-types": "off",
      },
    },
    {
      // The state layer sits at the bottom of a feature: client state must not reach up
      // into the server-state layer or the transport. Everything above is repeated from
      // the base config because oxlint replaces this rule rather than merging it.
      "files": ["src/features/*/*.state.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect"],
                "message": "useEffect is banned. Derive state, use event handlers, or - if truly unavoidable - add `// oxlint-disable-next-line no-restricted-imports` on the import with a justification comment.",
              },
            ],
            "patterns": [
              {
                "group": ["@/features/*/*"],
                "message": "Import a feature through its index (`@/features/counter`), not its internals. Inside a feature, import relatively (`./counter.state`).",
              },
              {
                "group": ["./*.queries", "./*.api"],
                "message": "Dependencies point one way: .state.ts <- .queries.ts <- components. Client state must not import the server-state layer or the transport. Derive the other direction instead.",
              },
            ],
          },
        ],
      },
    },
  ],
}
