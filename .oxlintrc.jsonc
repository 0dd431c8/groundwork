{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import",
    "unicorn",
    "oxc",
    "promise",
    "jsx-a11y",
    "vitest",
    "node",
    "react-perf",
  ],
  // ESLint plugins, run through oxlint's JS bridge (alpha, not covered by semver). Names are
  // aliases, since `react`, `import`, `typescript` and the rest are reserved by the native Rust
  // plugins. Rules go in `rules` below by that alias; categories do not reach them.
  "jsPlugins": [
    { "name": "query", "specifier": "@tanstack/eslint-plugin-query" },
    { "name": "router", "specifier": "@tanstack/eslint-plugin-router" },
    // Local, because nothing published lints Jotai. See lint/jotai.ts.
    { "name": "jotai", "specifier": "./lint/jotai.ts" },
    // Local for a different reason: eslint-plugin-sonarjs supplies no-identical-functions and
    // cannot load here, because it pulls in ts-api-utils, which reads `ts.TypeFlags` at module
    // scope and TypeScript 7 does not have one. See lint/dry.ts.
    { "name": "dry", "specifier": "./lint/dry.ts" },
    // Local because the shape of the rule is local: what counts as a raw element depends on
    // what src/components/ui holds. See lint/ui.ts.
    { "name": "ui", "specifier": "./lint/ui.ts" },
    // Neither name is reserved, so these two need no alias. Testing Library is in oxlint's
    // JS-plugin conformance suite (17,016 cases, all passing), so the bridge is not the risk
    // here that its alpha label suggests.
    "eslint-plugin-testing-library",
    "eslint-plugin-jest-dom",
  ],
  "options": {
    // Runs the type-aware rules below against the real TypeScript program, which is the
    // only tier that sees across a call boundary. Requires TypeScript 7.
    "typeAware": true,
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    // `style` is off: oxfmt already owns nearly all of it. `restriction` is off as a
    // category because it bans `async`/`await`; its two useful rules are listed below.
  },
  "env": {
    "browser": true,
    "es2024": true,
  },
  // Generated or vendored output, none of it hand-written and none of it hand-editable: a
  // `bunx shadcn add` rewrites src/components/ui wholesale, so a lint error there has no fix
  // that survives the next re-add. .oxfmtrc.jsonc and the coverage config draw the same line.
  "ignorePatterns": ["dist", "src/routeTree.gen.ts", "src/components/ui"],
  "rules": {
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": [
      "error",
      { "max": 40, "skipBlankLines": true, "skipComments": true, "IIFEs": true },
    ],
    "complexity": ["error", 15],

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    // `@ts-ignore` silences an error and forgets it; `@ts-expect-error` fails once the
    // underlying problem is fixed, and the description says what it was.
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": "allow-with-description", "ts-ignore": true, "ts-nocheck": true },
    ],
    // An inferred return type that is subtly wrong fails at the boundary, not downstream.
    "typescript/explicit-module-boundary-types": "error",
    "no-console": "error",

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-array-delete": "error",
    // Flags a React, TanStack or Jotai API the moment upstream deprecates it, so a version
    // bump surfaces the migration here rather than in a changelog nobody read.
    "typescript/no-deprecated": "error",
    "typescript/prefer-promise-reject-errors": "error",
    // TanStack Router signals a redirect and a 404 by throwing a plain object rather than an
    // Error, which is how a loader stops without the caller having to check a return value. The
    // rule cannot know those two are control flow, so name them; everything else still has to be
    // a real Error.
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "@tanstack/router-core",
            "name": ["Redirect", "NotFoundError"],
          },
        ],
      },
    ],

    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/prefer-nullish-coalescing": "error",

    // Runs the React Compiler's own analysis in lint-only mode, which is the only tier that
    // sees the Rules of React rather than just the Rules of Hooks: setState during render or
    // synchronously in an effect, reading a ref during render, mutating props, state or a
    // value returned from a hook, calling an impure function during render, defining a
    // component inside another component's render, and state derived in an effect that
    // belongs in render. `nursery`, so it is not reached by the categories above and an
    // oxlint minor can change what it reports; that is the price of the only rule here that
    // understands what React actually guarantees.
    "react/react-compiler": "error",
    // Fast Refresh only reloads a module that exports components and nothing else. Off for
    // `src/routes` below; `allowExportNames` does not help there, because it exempts the
    // export without exempting the local component beside it.
    "react/only-export-components": "error",
    // `restriction` rules, so also not reached by the categories. All four are React 19 house
    // style with nothing in `src` violating them today.
    "react/button-has-type": "error",
    "react/no-danger": "error",
    "react/no-clone-element": "error",
    "react/prefer-function-component": "error",
    // Design system rule, in lint/ui.ts rather than react/forbid-elements: a list of banned
    // elements is right only until src/components/ui grows a component nobody remembered to
    // ban the element for. This one allows structure and rejects the rest, so a
    // `bunx shadcn add textarea` needs no edit here, and a raw control fails on the day it is
    // written whether or not its component exists yet. src/components/ui is in ignorePatterns
    // above, so the primitives themselves are exempt.
    "ui/no-raw-element": "error",

    // The queryKey has to name everything the queryFn closes over, or two different fetches
    // share a cache entry. `prefer-query-options` is not in the plugin's recommended set; it
    // enforces the `queryOptions` in `<feature>.queries.ts` convention. `no-void-query-fn` is
    // left out because it needs type information the JS bridge does not hand over.
    "query/exhaustive-deps": "error",
    "query/stable-query-client": "error",
    "query/no-rest-destructuring": "error",
    "query/no-unstable-deps": "error",
    "query/infinite-query-property-order": "error",
    "query/mutation-property-order": "error",
    "query/prefer-query-options": "error",

    // The three Jotai practices no config-level rule can express. Like the plugins above,
    // categories do not reach these, so each one is named here.
    "jotai/no-atom-in-render": "error",
    "jotai/prefer-narrow-hook": "error",
    "jotai/atom-suffix": "error",

    // Duplication is the half of DRY a linter can decide. This one is exact and within a
    // single file, which is the copy most likely to drift and the cheapest to catch. Across
    // files is `bun run dupes`. Neither sees a component rewritten to do what an existing one
    // already does, so that half stays a review question.
    "dry/no-identical-functions": "error",

    "router/create-route-property-order": "error",
    "router/route-param-names": "error",

    // Not reached by the categories above. The first is what makes `globals: false` in
    // vitest.config.ts an error rather than a runtime surprise.
    "vitest/prefer-importing-vitest-globals": "error",
    "vitest/no-identical-title": "error",

    // The other three react-perf rules are hoist-a-constant fixes. This one's only remedy is
    // useCallback in every component that passes a handler, which buys nothing while the
    // child is not memoised.
    "react-perf/jsx-no-new-function-as-prop": "off",

    "import/no-cycle": "error",
    // Three overrides below redeclare this rule, and a redeclaration replaces it wholesale
    // rather than merging, so each one restates what it still wants. Change an entry here and
    // check all three. Where an override bans a whole module the named-import entries for it
    // are dropped rather than repeated, since the module ban already covers them.
    // Named imports only: `import React from 'react'` then `React.forwardRef` slips through.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect"],
            "message": "useEffect is banned. Derive state, use event handlers, or - if truly unavoidable - add `// oxlint-disable-next-line no-restricted-imports` on the import with a justification comment.",
          },
          {
            "name": "react",
            "importNames": ["forwardRef"],
            "message": "React 19 passes `ref` as an ordinary prop, so forwardRef is dead weight. Declare `ref` in the props type instead.",
          },
          {
            "name": "react",
            "importNames": ["createContext", "useContext"],
            "message": "Context is not the sharing mechanism here: Jotai owns client state and React Query owns server state. If a value genuinely has to be injected per subtree, add `// oxlint-disable-next-line no-restricted-imports` with a justification comment.",
          },
          {
            "name": "jotai",
            "importNames": ["getDefaultStore"],
            "message": "src/lib/store.ts wires an explicit `createStore()` that main.tsx passes to `<Provider>`. The default store silently bypasses it, so reads and writes land in a store nothing rendered against and tests stop being isolated.",
          },
        ],
        "patterns": [
          {
            "group": ["@/features/*/*"],
            "message": "Import a feature through its index (`@/features/<name>`), not its internals. Inside a feature, import relatively (`./<feature>.state`).",
          },
        ],
      },
    ],

    // Wrong under the automatic JSX runtime.
    "react/react-in-jsx-scope": "off",
    // The CSS and jest-dom side-effect imports are correct code.
    "import/no-unassigned-import": "off",
    // Wants `readonly` on every object parameter, React props included.
    "typescript/prefer-readonly-parameter-types": "off",
    // Without the option, `onClick={() => step(-1)}` needs a braced body just because
    // `step` returns void. The rest of the rule stays on.
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],

    "typescript/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "ignoreRestSiblings": true },
    ],
  },
  "overrides": [
    {
      // The git hook is a CLI: printing is how it reports, and it exits on the awaited
      // result, so `return await` is the correct form.
      "files": [".githooks/**/*.ts"],
      "rules": {
        "no-console": "off",
        "typescript/return-await": "off",
      },
    },
    {
      "files": [
        "src/**/*.test.{ts,tsx}",
        "src/test/**/*",
        "build/**/*.test.ts",
        "lint/**/*.test.ts",
        "lint/test/**/*",
      ],
      "rules": {
        "max-lines-per-function": "off",
        "max-lines": "off",
        // Test helpers stay next to the cases that use them.
        "unicorn/consistent-function-scoping": "off",
        // Two cases that set up identically and assert differently are two cases, not one
        // copy. Extracting the shared half into a helper is what makes a failing test say
        // less about what it was doing.
        "dry/no-identical-functions": "off",
      },
    },
    {
      // Testing Library and jest-dom, scoped to where tests live so they never look at
      // `build/` or `lint/`. Both plugins' own presets are unreachable from here, so this is
      // eslint-plugin-testing-library's `flat/react` config and jest-dom's `recommended`
      // written out by hand. `no-debugging-utils` is an error rather than the preset's warn:
      // a stray `screen.debug()` should fail CI, not scroll past in it.
      "files": ["src/**/*.test.{ts,tsx}", "src/test/**/*"],
      "rules": {
        "testing-library/await-async-events": ["error", { "eventModule": "userEvent" }],
        "testing-library/await-async-queries": "error",
        "testing-library/await-async-utils": "error",
        "testing-library/no-await-sync-events": ["error", { "eventModules": ["fire-event"] }],
        "testing-library/no-await-sync-queries": "error",
        "testing-library/no-container": "error",
        "testing-library/no-debugging-utils": "error",
        "testing-library/no-dom-import": ["error", "react"],
        "testing-library/no-global-regexp-flag-in-query": "error",
        "testing-library/no-manual-cleanup": "error",
        "testing-library/no-node-access": "error",
        "testing-library/no-promise-in-fire-event": "error",
        "testing-library/no-render-in-lifecycle": "error",
        "testing-library/no-unnecessary-act": "error",
        "testing-library/no-wait-for-multiple-assertions": "error",
        "testing-library/no-wait-for-side-effects": "error",
        "testing-library/no-wait-for-snapshot": "error",
        "testing-library/prefer-find-by": "error",
        "testing-library/prefer-presence-queries": "error",
        "testing-library/prefer-query-by-disappearance": "error",
        "testing-library/prefer-screen-queries": "error",
        "testing-library/render-result-naming-convention": "error",

        "jest-dom/prefer-checked": "error",
        "jest-dom/prefer-empty": "error",
        "jest-dom/prefer-enabled-disabled": "error",
        "jest-dom/prefer-focus": "error",
        "jest-dom/prefer-in-document": "error",
        "jest-dom/prefer-required": "error",
        "jest-dom/prefer-to-have-attribute": "error",
        "jest-dom/prefer-to-have-class": "error",
        "jest-dom/prefer-to-have-style": "error",
        "jest-dom/prefer-to-have-text-content": "error",
        "jest-dom/prefer-to-have-value": "error",
      },
    },
    {
      // A file-based route module has to export `Route`, and the component it names lives
      // beside it. Fast Refresh loses that module either way; the router owns its shape.
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off",
      },
    },
    {
      // Domain rules: constants, zod schemas and pure helpers. The bottom layer, so it
      // imports nothing above it and every layer can share one definition of what is valid.
      // The base entries are repeated because oxlint replaces the rule rather than merging.
      "files": ["src/features/*/*.schema.ts"],
      "rules": {
        // zod's `.catch()` supplies a fallback value for a schema and has nothing to do with a
        // promise; the rule is syntactic and cannot tell the two apart. Off here rather than
        // disabled line by line, because this layer is pure data and holds no promise to chain.
        "unicorn/prefer-top-level-await": "off",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "A schema is a plain value with no framework in it, which is what lets every layer above import it. Anything that needs a hook belongs in a component or in <feature>.queries.ts.",
              },
              {
                "name": "jotai",
                "message": "A schema describes what is valid, not what is stored. Atoms go in <feature>.state.ts, which may import this file.",
              },
              {
                "name": "@tanstack/react-query",
                "message": "The bottom layer never reaches up into the server-state layer. Query definitions go in <feature>.queries.ts.",
              },
              {
                "name": "@tanstack/react-form",
                "message": "The schema is the contract; the form that renders it is a component. Keep useForm in the <feature> .tsx file that owns the form.",
              },
            ],
            "patterns": [
              {
                "group": ["@/features/*/*"],
                "message": "Import a feature through its index (`@/features/<name>`), not its internals. Inside a feature, import relatively (`./<feature>.state`).",
              },
              {
                "group": ["./*.state", "./*.queries", "./*.api"],
                "message": "Dependencies point one way: .schema.ts <- .state.ts <- .api.ts <- .queries.ts <- components. The schema layer is the bottom and imports none of them.",
              },
            ],
          },
        ],
      },
    },
    {
      // Client state must not reach up into the server-state layer or the transport, and an
      // atom is a plain value with no React in it. The base entries are repeated because
      // oxlint replaces the rule rather than merging it; `react` is banned outright here,
      // which subsumes the three named-import entries in the base rule.
      "files": ["src/features/*/*.state.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "Atoms are plain values with no React in them, which is what lets <feature>.state.test.ts drive them through a bare createStore(). Anything that needs a hook belongs in a component or in <feature>.queries.ts.",
              },
              {
                "name": "@tanstack/react-query",
                "message": "Client state never reaches into the server-state layer. Banning the relative ./*.queries path alone still leaves the package importable directly.",
              },
              {
                "name": "jotai",
                "importNames": ["getDefaultStore"],
                "message": "src/lib/store.ts wires an explicit `createStore()` that main.tsx passes to `<Provider>`. The default store silently bypasses it, so reads and writes land in a store nothing rendered against and tests stop being isolated.",
              },
            ],
            "patterns": [
              {
                "group": ["@/features/*/*"],
                "message": "Import a feature through its index (`@/features/<name>`), not its internals. Inside a feature, import relatively (`./<feature>.state`).",
              },
              {
                "group": ["./*.queries", "./*.api"],
                "message": "Dependencies point one way: .state.ts <- .queries.ts <- components. Client state must not import the server-state layer or the transport. Derive the other direction instead.",
              },
            ],
          },
        ],
      },
    },
    {
      // The transport: fetch and its types, nothing else. This is what keeps
      // `vi.mock('./<feature>.api')` meaningful, since the real query wiring stays above it.
      "files": ["src/features/*/*.api.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "The transport is the one layer with no framework in it. Keep fetch and its types here; put anything React-shaped in <feature>.queries.ts or a component.",
              },
              {
                "name": "@tanstack/react-query",
                "message": "The transport stays React Query free, which is what lets a test vi.mock('./<feature>.api') and still exercise the real queryOptions wiring. Query definitions go in <feature>.queries.ts.",
              },
              {
                "name": "jotai",
                "message": "The transport is the one layer with no framework in it. Server data never gets copied into an atom.",
              },
            ],
            "patterns": [
              {
                "group": ["@/features/*/*"],
                "message": "Import a feature through its index (`@/features/<name>`), not its internals. Inside a feature, import relatively (`./<feature>.state`).",
              },
            ],
          },
        ],
      },
    },
    {
      // Components read queries and call hooks the queries layer exports; they do not own
      // mutations or reach for the client. Covers *.test.tsx too, deliberately: a test that
      // needs a raw client is testing the wiring, not the feature.
      "files": ["src/features/*/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect"],
                "message": "useEffect is banned. Derive state, use event handlers, or - if truly unavoidable - add `// oxlint-disable-next-line no-restricted-imports` on the import with a justification comment.",
              },
              {
                "name": "react",
                "importNames": ["forwardRef"],
                "message": "React 19 passes `ref` as an ordinary prop, so forwardRef is dead weight. Declare `ref` in the props type instead.",
              },
              {
                "name": "react",
                "importNames": ["createContext", "useContext"],
                "message": "Context is not the sharing mechanism here: Jotai owns client state and React Query owns server state. If a value genuinely has to be injected per subtree, add `// oxlint-disable-next-line no-restricted-imports` with a justification comment.",
              },
              {
                "name": "jotai",
                "importNames": ["getDefaultStore"],
                "message": "src/lib/store.ts wires an explicit `createStore()` that main.tsx passes to `<Provider>`. The default store silently bypasses it, so reads and writes land in a store nothing rendered against and tests stop being isolated.",
              },
              {
                "name": "@tanstack/react-query",
                "importNames": ["useMutation", "useQueryClient"],
                "message": "A mutation gets a named hook in <feature>.queries.ts, because what it invalidates is a fact about the data, not about the widget that triggered it - a component should never name a query key. Reading a query with `useQuery(<feature>Query)` stays fine here.",
              },
            ],
            "patterns": [
              {
                "group": ["@/features/*/*"],
                "message": "Import a feature through its index (`@/features/<name>`), not its internals. Inside a feature, import relatively (`./<feature>.state`).",
              },
            ],
          },
        ],
      },
    },
  ],
}
