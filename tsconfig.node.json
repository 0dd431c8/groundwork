{
  // Tooling that runs in Bun rather than the browser: the Vite config and the git
  // hooks. Same strictness as the app, different globals and no DOM.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `composite` is what makes this a referenced project, and TS7 forbids a
    // referenced project from setting `noEmit` (TS6310). So the emit has to go
    // somewhere harmless: left at the default it would write vite.config.js next
    // to vite.config.ts, and Vite loads a stale .js in preference to the .ts.
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "lib": ["ESNext"],
    "types": ["bun"]
  },
  // A glob, not a filename: vitest.config.ts and playwright.config.ts are already
  // referenced by package.json scripts and should be covered the day they appear.
  "include": ["*.config.ts", ".githooks/**/*.ts"],
  "references": []
}
