{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  // Vendored output, rewritten verbatim by `bunx shadcn add` and `bunx skills add`. Add a
  // directory here when you install the skills for another agent.
  "ignorePatterns": [
    "dist",
    "src/routeTree.gen.ts",
    "src/components/ui",
    ".agents",
    ".claude",
    ".roo",
    ".windsurf",
  ],
}
